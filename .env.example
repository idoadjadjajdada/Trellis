# Copy to .env (Docker Compose reads it automatically) and adjust.

# The address people and AI apps use to reach Trellis. Passkeys are tied to this host name,
# so set it before creating accounts. Must be https:// unless it is localhost.
PUBLIC_URL=http://localhost:3000

# Postgres with pgvector. (Docker Compose sets this for you.)
# DATABASE_URL=postgres://trellis:trellis@localhost:5432/trellis

# Embeddings: "local" runs bge-small-en-v1.5 inside Trellis (no API key, ~130 MB download on first start).
# "openai" uses text-embedding-3-small and needs OPENAI_API_KEY.
EMBEDDING_PROVIDER=local
# EMBEDDING_MODEL=
# OPENAI_API_KEY=

# Set to false after creating your account to stop anyone else signing up.
ALLOW_SIGNUP=true

# Behind a reverse proxy or load balancer, set to true (or the number of proxy hops).
# TRUST_PROXY=
